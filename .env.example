# Discord bot credentials and configuration
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Optional: comma-separated Discord user IDs that may use protected commands
AUTHORIZED_USER_IDS=

# Optional DM-only behavior: true or false
DM_ENABLED=true

# Optional audit log channel ID
LOG_CHANNEL_ID=

# Optional cooldown in seconds
COMMAND_COOLDOWN_SECONDS=5
